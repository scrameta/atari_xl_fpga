+          eng_wdata2(18 downto 17) <= std_logic_vector(rtp_reg);
+          eng_wdata2(29 downto 19) <= std_logic_vector(rtd_reg);
+          if aux2_wack = '1' then
+            pend_next(to_integer(voice_reg)) <= '1';
+            state_next <= st_idle;
