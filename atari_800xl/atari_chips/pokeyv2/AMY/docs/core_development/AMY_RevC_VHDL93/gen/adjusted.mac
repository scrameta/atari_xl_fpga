$
$	This file contains macros for cell definitions used in the
$ DAISY generated net list for the AMY1 sound synthesizer.
$
$	This file
$ has been hand editted to add the macro "cntr2" which is used in a
$ hand editted version of the original chip net list.
$
$	This file has had the CMP cell modified to eliminate a 
$ feedback path thru the two nmos transistors.  This gives SILOS a
$ problem in that an unknown input to the selector input effectively
$ shorts the inverse of one input to the other input.
$
$	This file has also had all occurances of vcc replaced by .vcc
$ and gnd replaced by .gnd
$ to take advantage of SILOS automatic definition and anticipated
$ updates to SILOS that will make certain substitution of resistive
$ uni-directional functions for bi-directionals controlled by supplies.
$
$
$	A "trihpu" cell is substituted for the "trih" at the outputs
$ of the phase ram and the transistor pullups were eliminated to permit
$ the ram, with its resistive strength low level, to drive the outputs.
$
$
$
.MACRO   ADD   A B PR CON S
X4K0                .NAND/N      A B                                 $/USER/BOB/AMY/CELLS/ADD 1 XCMP10 PAGE=0 71 59
X3K0                .NOR/N      X4K0 PR                              $/USER/BOB/AMY/CELLS/ADD 1 XCMP11 PAGE=0 56 58
XCMP12              .NMOS     PR .vcc CON                             $/USER/BOB/AMY/CELLS/ADD 1 65 68
XCMP13              .NMOS     X3K0 CON .gnd                           $/USER/BOB/AMY/CELLS/ADD 1 52 58
X5K0                .NOR/N      A B                                  $/USER/BOB/AMY/CELLS/ADD 1 XCMP4 PAGE=0 105 82
S                   .NOR/N      X5K0 X6K0                            $/USER/BOB/AMY/CELLS/ADD 1 XCMP5 PAGE=0 123 81
X6K0                .AND/N      A B                                  $/USER/BOB/AMY/CELLS/ADD 1 XCMP6 PAGE=0 112 77
.EOM  ADD
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$
$
.MACRO   ALEIOB   IN SEL OUT ALE
XCMP21              .NMOS     ALE X17K0 .gnd                          $/USER/BOB/AMY/CELLS/ALEIOB 1 120 39
XCMP22              .NMOS     ALE X17K0 .gnd                          $/USER/BOB/AMY/CELLS/ALEIOB 1 112 33
XCMP23              .NMOS     .vcc X19K0 X17K0                        $/USER/BOB/AMY/CELLS/ALEIOB 1 116 45
$ XCMP24              .NMOS     .vcc .VCC X19K0                          $/USER/BOB/AMY/CELLS/ALEIOB 1 116 51
x19k0 .res .vcc
X6K0                .NOR/N      IN  X28K0                            $/USER/BOB/AMY/CELLS/ALEIOB 1 XCMP25 103 75
X21K0               .NOR/N      X28K0 IN                             $/USER/BOB/AMY/CELLS/ALEIOB 1 XCMP26 PAGE=0 100 81
X5K0                .NOR/N      X28K0  X2K0                          $/USER/BOB/AMY/CELLS/ALEIOB 1 XCMP27 103 94
X22K0               .NOR/N      X28K0 X2K0                           $/USER/BOB/AMY/CELLS/ALEIOB 1 XCMP28 PAGE=0 100 100
OUT                 .NOR/N      X17K0 X23K0                          $/USER/BOB/AMY/CELLS/ALEIOB 1 XCMP29 PAGE=0 92 44
XCMP3               .NMOS     X5K0 .vcc ALE                           $/USER/BOB/AMY/CELLS/ALEIOB 1 122 93
X23K0               .INV/N      X28K0                                $/USER/BOB/AMY/CELLS/ALEIOB 1 XCMP30 PAGE=0 95 63
X28K0               .INV/N      SEL                                  $/USER/BOB/AMY/CELLS/ALEIOB 1 XCMP37 PAGE=0 66 106
XCMP4               .NMOS     X6K0 ALE .gnd                           $/USER/BOB/AMY/CELLS/ALEIOB 1 122 74
X2K0                .INV/N      IN                                   $/USER/BOB/AMY/CELLS/ALEIOB 1 XCMP8 PAGE=0 87 82
.EOM  ALEIOB
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$
$
.MACRO   CMP   A B EQ
XCMP13              .NMOS     X5K0 EQ .gnd                            $/USER/BOB/AMY/CELLS/CMP 1 140 45
X3K0                .INV/N      A                                    $/USER/BOB/AMY/CELLS/CMP 1 XCMP4 PAGE=0 72 60
X4K0                .INV/N      B                                    $/USER/BOB/AMY/CELLS/CMP 1 XCMP5 PAGE=0 72 51
aa	.inv/n	x3k0
bb	.inv/n	x4k0
$XCMP6               .NMOS     A X4K0 X5K0                            $/USER/BOB/AMY/CELLS/CMP 1 110 53
$XCMP7               .NMOS     X3K0 B X5K0                            $/USER/BOB/AMY/CELLS/CMP 1 118 47
xcmp6	.nmos	aa x4k0 x5k0
xcmp7	.nmos	x3k0 bb x5k0
.EOM  CMP
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$
$
.MACRO   CNTR   C CIN CN R CO Q QN
QN                  .INV/N      Q                                    $/USER/BOB/AMY/CELLS/CNTR 1 XCMP12 PAGE=0 137 80
X29K0               .INV/N      CIN                                  $/USER/BOB/AMY/CELLS/CNTR 1 XCMP16 PAGE=0 107 60
CO                  .NOR/N      QN X29K0                             $/USER/BOB/AMY/CELLS/CNTR 1 XCMP17 PAGE=0 156 61
XCMP19              .NMOS     C X27K0 X11K0                          $/USER/BOB/AMY/CELLS/CNTR 1 112 82
XCMP20              .NMOS     CN X18K0 X26K0                         $/USER/BOB/AMY/CELLS/CNTR 1 79 82
X18K0               .NOR/N      R X1K0                               $/USER/BOB/AMY/CELLS/CNTR 1 XCMP21 PAGE=0 65 80
X27K0               .INV/N      X26K0                                $/USER/BOB/AMY/CELLS/CNTR 1 XCMP22 PAGE=0 89 80
XCMP23              .NMOS     CIN X1K0 Q                             $/USER/BOB/AMY/CELLS/CNTR 1 93 60
XCMP24              .NMOS     X29K0 X1K0 QN                          $/USER/BOB/AMY/CELLS/CNTR 1 126 60
Q                   .INV/N      X11K0                                $/USER/BOB/AMY/CELLS/CNTR 1 XCMP5 PAGE=0 120 80
.EOM  CNTR
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$
$
.MACRO   CNTR2   C CIN CN R CO Q QN
$ a counter cell with buffered drive to internal feed-back transistors
QN                  .INV/N      Q                                    $/USER/BOB/AMY/CELLS/CNTR 1 XCMP12 PAGE=0 137 80
X29K0               .INV/N      CIN                                  $/USER/BOB/AMY/CELLS/CNTR 1 XCMP16 PAGE=0 107 60
CO                  .NOR/N      QN X29K0                             $/USER/BOB/AMY/CELLS/CNTR 1 XCMP17 PAGE=0 156 61
XCMP19              .NMOS     C X27K0 X11K0                          $/USER/BOB/AMY/CELLS/CNTR 1 112 82
XCMP20              .NMOS     CN X18K0 X26K0                         $/USER/BOB/AMY/CELLS/CNTR 1 79 82
X18K0               .NOR/N      R X1K0                               $/USER/BOB/AMY/CELLS/CNTR 1 XCMP21 PAGE=0 65 80
X27K0               .INV/N      X26K0                                $/USER/BOB/AMY/CELLS/CNTR 1 XCMP22 PAGE=0 89 80
Q                   .INV/N      X11K0                                $/USER/BOB/AMY/CELLS/CNTR 1 XCMP5 PAGE=0 120 80
XCMP23              .NMOS     CIN X1K0 whiskey                          $/USER/BOB/AMY/CELLS/CNTR 1 93 60
XCMP24              .NMOS     X29K0 X1K0 xray                       $/USER/BOB/AMY/CELLS/CNTR 1 126 60
whiskey	.inv/n qn
xray	.inv/n q
.EOM  CNTR2
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
$
$
.MACRO	CNTR3	C CIN CN R CO Q QN
$ a counter cell with buffered drive to one internal feed-back transistor
QN		.INV/N	Q
X29K0		.INV/N	CIN
CO		.NOR/N	QN X29K0
XCMP19		.NMOS	C X27K0 X11K0
XCMP20		.NMOS	CN X18K0 X26K0
X18K0		.NOR/N	R X1K0
X27K0		.INV/N	X26K0
Q		.INV/N	X11K0
XCMP23		.NMOS	CIN X1K0 yankee
XCMP24		.NMOS	X29K0 X1K0 qn
yankee		.inv/n	x11k0
.EOM	CNTR3
